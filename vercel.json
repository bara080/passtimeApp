{
  "version": 2,
  "builds": [
    {
      "src": "Backend/index.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["Backend/**"] }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "Backend/index.js" }
  ],
  "crons": [
    { "path": "/api/warmup", "schedule": "*/5 * * * *" }
  ]
}
