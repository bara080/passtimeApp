{
  "rules": {
    ".read": false,
    ".write": false,

    "chats": {
      "$chatId": {
        ".read": "auth != null && (root.child('chats').child($chatId).child('meta').child('memberUid').val() === auth.uid || root.child('chats').child($chatId).child('meta').child('hostUid').val() === auth.uid)",
        ".write": false,

        "meta": {
          ".validate": "newData.hasChildren(['chatId','memberUid','hostUid'])"
        },
        "messages": {
          "$messageId": {
            ".validate": "newData.hasChildren(['sender','text','timestamp']) && newData.child('text').isString() && newData.child('text').val().length <= 1000"
          }
        },
        "typing": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['isTyping','timestamp'])"
          }
        }
      }
    }
  }
}
